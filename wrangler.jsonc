{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-auto-guard",
  "main": "index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CF_LIST_NAME": "auto_guard_block",
    "DRY_RUN": "false"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}