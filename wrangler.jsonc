{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-auto-guard",
  "main": "index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CF_LIST_NAME": "auto_guard_block",
    "DRY_RUN": "false",
    "CF_ACCOUNT_ID": "your-cf-account-id",
    "CF_ZONE_ID": "your-cf-zone-id",
    "CF_API_TOKEN": "your-api-token",
    "CF_LIST_ID": "your-list-id"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}