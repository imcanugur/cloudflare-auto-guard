{
  "enabled": true,
  "windowSeconds": 3600,
  "topN": 100,
  "default": {
    "enabled": true,
    "threshold": 1000,
    "action": "block"
  },
  "allowlist": [
    "1.1.1.1",
    "8.8.8.8"
  ],
  "countries": {
    "TR": {
      "enabled": false
    },
    "US": {
      "enabled": true,
      "threshold": 2000,
      "action": "block"
    },
    "DE": {
      "enabled": true,
      "threshold": 1500,
      "action": "block"
    },
    "NL": {
      "enabled": true,
      "threshold": 1000,
      "action": "block"
    }
  },
  "unban": {
    "enabled": true,
    "ttlSeconds": 86400,
    "maxListSize": 9000
  },
  "scanner": {
    "enabled": true,
    "max404Threshold": 25,
    "windowSeconds": 300,
    "enableHoneypot": true,
    "trapPaths": [
      "/.env",
      "/.git",
      "/.git/config",
      "/.aws/credentials",
      "/wp-login.php",
      "/xmlrpc.php",
      "/wp-config.php",
      "/phpmyadmin",
      "/pma",
      "/adminer.php",
      "/actuator",
      "/actuator/health",
      "/shell.php",
      "/backup.sql",
      "/dump.sql"
    ],
    "action": "block"
  }
}
